PORT=8000
DB_NAME=food_application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
CORS_ORIGIN=http://localhost:5173
# Set to the deployed API's public HTTPS origin in production.
SERVER_URL=http://localhost:8000
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
# Email delivery uses Resend. Set MAIL_FROM to an address on a domain
# verified in your Resend account; do not use this placeholder literally.
RESEND_API_KEY=re_your_resend_api_key
RESEND_TEMPLATE_ID=your_resend_template_id
MAIL_FROM="Food Application <noreply@your-domain.com>"
# Email address that receives pending restaurant approval requests.
SUPER_ADMIN_EMAIL=admin@your-domain.com
# Order notifications can use a dedicated inbox; otherwise SUPER_ADMIN_EMAIL is used.
ORDER_NOTIFICATION_EMAIL=adarshk8271@gmail.com
# Contact-form enquiries use this inbox; otherwise SUPER_ADMIN_EMAIL is used.
CONTACT_ENQUIRY_EMAIL=adarshk8271@gmail.com
