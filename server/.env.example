PORT=8000
DB_NAME=food_application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
CORS_ORIGIN=http://localhost:5173
SERVER_URL=http://localhost:8000
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
