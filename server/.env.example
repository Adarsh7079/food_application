PORT=8000
DB_NAME=food_application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
CORS_ORIGIN=http://localhost:5173
# Set to the deployed API's public HTTPS origin in production.
SERVER_URL=http://localhost:8000
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Use true for implicit TLS (commonly port 465); false for STARTTLS (commonly port 587).
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Food Application <no-reply@example.com>"
