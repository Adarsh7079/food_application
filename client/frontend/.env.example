        # Backend origin only. API routes are appended by the frontend.
# Leave unset for local development (Vite proxies /api to localhost:8000).
# Set this in production if the API is hosted at a different origin.
# VITE_BACKEND_URL=https://api.zaykanest.in

# Set false only when deploying against a backend without the public products route.
VITE_PRODUCTS_API_ENABLED=true
